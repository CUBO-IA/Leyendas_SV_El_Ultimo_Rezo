{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leyendas-sv.local/contract/api_error.schema.json",
  "title": "ApiError",
  "type": "object",
  "required": [
    "error",
    "detail"
  ],
  "additionalProperties": false,
  "properties": {
    "error": {
      "enum": [
        "bad_request",
        "session_not_found",
        "bad_npc",
        "bad_evidence",
        "evidence_not_owned",
        "bad_object",
        "location_locked",
        "cannot_accuse",
        "session_ended",
        "model_not_ready",
        "stt_failed",
        "internal"
      ]
    },
    "detail": {
      "type": "string"
    }
  }
}
