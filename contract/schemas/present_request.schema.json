{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leyendas-sv.local/contract/present_request.schema.json",
  "title": "PresentRequest",
  "type": "object",
  "required": [
    "session_id",
    "npc_id",
    "evidence_id",
    "want_audio"
  ],
  "additionalProperties": false,
  "properties": {
    "session_id": {
      "$ref": "common.schema.json#/$defs/session_id"
    },
    "npc_id": {
      "$ref": "common.schema.json#/$defs/witness_id"
    },
    "evidence_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "want_audio": {
      "type": "boolean"
    }
  }
}
