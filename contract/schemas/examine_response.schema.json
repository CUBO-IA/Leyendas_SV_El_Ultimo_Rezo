{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leyendas-sv.local/contract/examine_response.schema.json",
  "title": "ExamineResponse",
  "type": "object",
  "required": [
    "text",
    "new_evidence",
    "state"
  ],
  "additionalProperties": false,
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "new_evidence": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "state": {
      "$ref": "world_state.schema.json"
    }
  }
}
