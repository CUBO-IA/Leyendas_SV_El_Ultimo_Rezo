# --- Motor (Ingeniero B) ---
# 127.0.0.1: todo corre en la misma laptop. 0.0.0.0 solo si Godot entra desde otra máquina.
API_HOST=127.0.0.1
API_PORT=8000
DEMO_MODE=0

# Diálogo: ollama | nvidia. Elegido en B1 (tools/smoke_llm.py): nvidia Lightning, mediana 0.7 s.
# Ollama local con nemotron-3-nano:4b queda de respaldo sin internet (mediana 4.6 s).
LLM_PROVIDER=nvidia
# Modelo de Ollama
LLM_MODEL=nemotron-3-nano:4b
OLLAMA_URL=http://127.0.0.1:11434
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Alternativa más rápida y seca: nvidia/nemotron-3.5-bolt-e4b
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_TIMEOUT_S=30
# Base de datos de partidas (por defecto server/sessions.db)
# DB_PATH=

# Voz del jugador a texto: nvidia | whisper
STT_PROVIDER=nvidia
STT_API_KEY=
STT_BASE_URL=

# Voz de los NPC: magpie | piper
TTS_PROVIDER=magpie

# ComfyUI (retratos)
COMFYUI_URL=http://127.0.0.1:8188

# --- Cliente (Ingeniero A) ---
API_BASE_URL=http://127.0.0.1:8000
