# --- Motor (Ingeniero B) ---
# 127.0.0.1: todo corre en la misma laptop. 0.0.0.0 solo si Godot entra desde otra máquina.
API_HOST=127.0.0.1
API_PORT=8000
DEMO_MODE=0
# Testigos en la partida: all (los 10) o mvp (solo los 6 del MVP).
WITNESSES=all

# Diálogo: ollama | nvidia. Elegido en B1 (tools/smoke_llm.py): nvidia Lightning, mediana 0.7 s.
# Ollama local con nemotron-3-nano:4b queda de respaldo sin internet (mediana 4.6 s).
LLM_PROVIDER=nvidia
# Modelo de Ollama
LLM_MODEL=nemotron-3-nano:4b
OLLAMA_URL=http://127.0.0.1:11434
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Alternativa más rápida y seca: nvidia/nemotron-3.5-bolt-e4b
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_TIMEOUT_S=30
# Tope por respuesta durante el juego; si se pasa, el testigo usa una frase de respaldo
LLM_REPLY_TIMEOUT_S=12
# Base de datos de partidas (por defecto server/sessions.db)
# DB_PATH=

# Voz (B4): Magpie TTS y reconocedor por gRPC en build.nvidia.com con NVIDIA_API_KEY.
# nvidia | none
STT_PROVIDER=nvidia
# magpie | none
TTS_PROVIDER=magpie
# Opcionales (valores por defecto en server/app/config.py):
# RIVA_SERVER=grpc.nvcf.nvidia.com:443
# TTS_FUNCTION_ID=877104f7-e885-42b9-8de8-f6e4c6303969
# ASR_FUNCTION_IDS=71203149-d3b7-4460-8231-1be2543a1fca,a9eeee8f-b509-4712-b19d-194361fa5f31

# ComfyUI (retratos)
COMFYUI_URL=http://127.0.0.1:8188

# --- Cliente (Ingeniero A) ---
API_BASE_URL=http://127.0.0.1:8000
